# Copie para web/.env (nunca versionado) para rodar localmente. Na Vercel, cadastre em Settings > Environment Variables.
# Chave do AI Gateway. Na Vercel pode ficar vazia se o projeto usar a autenticação OIDC do próprio deploy.
AI_GATEWAY_API_KEY=
# Modelo no formato do Gateway (provedor/modelo), com streaming e ferramentas
# openai/gpt-5.2 é o modelo usado na avaliação (README, "Assistente de IA"): no plano gratuito do Gateway os modelos Claude são
# recusados (403). Com créditos pagos, anthropic/claude-sonnet-5 (o padrão do código), repetindo a avaliação
AI_MODEL=openai/gpt-5.2
# Interruptor: false desliga o chat sem derrubar o dashboard
CHAT_ATIVO=true
# Orçamento por turno e limites
MAX_CHAMADAS_DADOS=8
MAX_CENAS=3
MAX_TOKENS_SAIDA=1200
TIMEOUT_MS=60000
# Limite por IP dentro de uma instância da função (não é global; veja o README)
LIMITE_PEDIDOS_POR_IP=30
JANELA_LIMITE_MINUTOS=10
